{
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(sudo *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(npx *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git branch -D *)",
      "Bash(dd *)",
      "Bash(chmod 777 *)",
      "Bash(> *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "WebFetch(domain:*)"
    ],
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:cdn.jsdelivr.net)",
      "WebFetch(domain:unpkg.com)"
    ]
  },
  "cleanupPeriodDays": 14,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".ai-config/ifacts-quality/hooks/warn-destructive.sh"
          },
          {
            "type": "command",
            "command": ".ai-config/ifacts-devops/hooks/warn-force-push.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".ai-config/ifacts-quality/hooks/session-summary.sh"
          }
        ]
      }
    ]
  }
}
